# Solo el gateway se publica en la computadora del desarrollador.
GATEWAY_HOST_PORT=8080

# MySQL local (contenedor mysql). Una base y un usuario por microservicio; mysql-init los
# crea en cada arranque con infra/mysql/init/01-create-databases.sh.
MYSQL_ROOT_PASSWORD=medicalsys-root-local
IDENTIDAD_DB_PASSWORD=identidad-local
TENENCIA_DB_PASSWORD=tenencia-local
CATALOGOS_DB_PASSWORD=catalogos-local
CRIPTOGRAFIA_DB_PASSWORD=criptografia-local
PACIENTES_DB_PASSWORD=pacientes-local
PROFESIONALES_DB_PASSWORD=profesionales-local
HISTORIAL_DB_PASSWORD=historial-local
DOCUMENTAL_DB_PASSWORD=documental-local
FACTURACION_DB_PASSWORD=facturacion-local
NOTIFICACIONES_DB_PASSWORD=notificaciones-local
MARKETING_DB_PASSWORD=marketing-local
AUDITORIA_DB_PASSWORD=auditoria-local

# Keycloak (IAM-01). Base «keycloak» dentro del Postgres de la plataforma; la crea
# keycloak-db-init. Los secretos reales se guardan en KeePassXC, nunca en este archivo.
# Consola: http://localhost:18080/admin (unico puerto publicado ademas del gateway).
KEYCLOAK_HOST_PORT=18080
KEYCLOAK_DB_PASSWORD=replace-with-a-local-db-password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-password
# Secreto del cliente confidencial ms-identidad (el realm lo lee de esta variable).
KEYCLOAK_MS_IDENTIDAD_CLIENT_SECRET=replace-with-a-long-random-secret

# Ubicaciones Flyway opcionales para datos de demostracion.
PACIENTES_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
PROFESIONALES_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
HISTORIAL_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
AUDITORIA_DEMO_SEED=true

# PostgreSQL de ms-agenda.
AGENDA_DB_PASSWORD=agenda-local
AGENDA_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# Seguridad local del MVP.
JWT_SECRET=medicalsys-local-jwt-secret-at-least-32-bytes
DEMO_MASTER_KEY=medicalsys-demo-key-local
# Secreto con el que ms-historial se identifica ante ms-criptografia; en local, cualquier valor no vacio.
CRYPTO_SERVICE_SHARED_SECRET=medicalsys-crypto-shared-local
# UUID compartido por las cuentas demo y la organización DEMO de ms-tenencia.
IDENTITY_DEMO_USERS_ENABLED=false
IDENTITY_DEMO_ORGANIZATION=00000000-0000-4000-8000-0000000000a1

# Bootstrap opcional de la cuenta que crea nuevas organizaciones. Activar solo durante
# el primer arranque, usar una contraseña propia y volver a desactivar después.
PLATFORM_ADMIN_SEED_ENABLED=false
PLATFORM_ADMIN_PUBLIC_ID=00000000-0000-4000-8000-000000000900
PLATFORM_ADMIN_ORGANIZATION=00000000-0000-4000-8000-0000000000a1
PLATFORM_ADMIN_EMAIL=platform.admin@medicalsys.demo
PLATFORM_ADMIN_FULL_NAME=Administrador de MedicalSys
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password

# CORS del gateway: lista exacta y separada por comas de origenes autorizados.
GATEWAY_ALLOWED_ORIGINS=http://localhost:4200

# Almacenamiento de objetos de ms-documental.
MINIO_ROOT_USER=medicalsys-demo
MINIO_ROOT_PASSWORD=medicalsys-minio-local
MINIO_BUCKET=medicalsys-documents-local
DOCUMENT_MAX_SIZE_BYTES=104857600

# Notificaciones. El proveedor mock es seguro para desarrollo; meta exige credenciales reales.
NOTIFICATION_PROVIDER=mock
WHATSAPP_MANUAL_SEND_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_KAFKA_ENABLED=true
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_APP_SECRET=
