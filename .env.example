# Puertos publicados en la computadora del desarrollador.
# Los puertos internos de los contenedores no deben cambiarse.
GATEWAY_HOST_PORT=8080
IDENTITY_HOST_PORT=8081
TENANCY_HOST_PORT=8082
CATALOGS_HOST_PORT=8083
CRYPTOGRAPHY_HOST_PORT=8084
PATIENTS_HOST_PORT=8085
PROFESSIONALS_HOST_PORT=8086
SCHEDULING_HOST_PORT=8087
MEDICAL_RECORDS_HOST_PORT=8088
DOCUMENTS_HOST_PORT=8089
BILLING_HOST_PORT=8090

# Puertos opcionales para acceder a la infraestructura desde la computadora.
# Entre contenedores se siguen usando 3306, 5432, 6379, 9000 y 9001.
MYSQL_HOST_PORT=13306
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# MySQL y credenciales independientes por microservicio.
MYSQL_ROOT_PASSWORD=medicalsys-root-local
IDENTIDAD_DB_PASSWORD=identidad-local
TENENCIA_DB_PASSWORD=tenencia-local
CATALOGOS_DB_PASSWORD=catalogos-local
CRIPTOGRAFIA_DB_PASSWORD=criptografia-local
PACIENTES_DB_PASSWORD=pacientes-local
PROFESIONALES_DB_PASSWORD=profesionales-local
HISTORIAL_DB_PASSWORD=historial-local
DOCUMENTAL_DB_PASSWORD=documental-local
FACTURACION_DB_PASSWORD=facturacion-local

# PostgreSQL de ms-agenda.
AGENDA_DB_PASSWORD=agenda-local

# Seguridad local del MVP.
JWT_SECRET=medicalsys-jwt-local
DEMO_MASTER_KEY=medicalsys-demo-key-local

# Almacenamiento de objetos de ms-documental.
MINIO_ROOT_USER=medicalsys-demo
MINIO_ROOT_PASSWORD=medicalsys-minio-local
MINIO_BUCKET=medicalsys-documents
