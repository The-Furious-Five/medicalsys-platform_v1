# Java y Maven
**/target/
**/.mvn/timing.properties

# Gradle, si llegara a utilizarse
**/build/
**/.gradle/

# IntelliJ IDEA
.idea/
**/*.iml

# Visual Studio Code
.vscode/

# Sistema operativo
.DS_Store
Thumbs.db

# Variables y secretos (.env.example si se versiona: es la plantilla sin secretos)
.env
.env.*
!.env.example

# Node: dependencias de scripts sueltos o de herramientas de IA. Sin barra final para que tambien
# cubra un symlink llamado node_modules (asi se colo uno que apuntaba a la Mac de otro integrante).
node_modules
node_modules/

# Python: cache de bytecode de los scripts de CI
__pycache__/
*.py[cod]

# Logs
*.log
logs/

# Archivos temporales (incluye los ~$archivo.docx que deja Office mientras un documento esta abierto)
~$*
tmp/
*.tmp

# Evidencias locales
docs/demo/evidence/

# Override local de Compose para la demo (no se comparte)
compose.override.yaml
