# Valores desechables para el entorno de evidencia. No son credenciales reales.
AIVEN_MYSQL_HOST=mysql-local
AIVEN_MYSQL_PORT=3306
AIVEN_MYSQL_USER=root
AIVEN_MYSQL_PASSWORD=evidencia-local-no-real
AIVEN_DB_POOL_SIZE=3
AIVEN_KEEPALIVE_ENABLED=false
# Las cuentas demo vienen apagadas por defecto (HARD-03); se encienden solo para poder iniciar sesion en la prueba.
IDENTITY_DEMO_USERS_ENABLED=true
