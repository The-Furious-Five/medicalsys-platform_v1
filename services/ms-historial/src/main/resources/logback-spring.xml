<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs con serviceName y correlationId (guia Sprint 2, seccion 10.5).
  Nunca se registra narrativa clinica, ciphertext, JWT ni claves: solo identificadores.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="ms-historial"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} %-5level [${serviceName}] [corr=%X{correlationId:-none}] [org=%X{organizationId:-none}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
