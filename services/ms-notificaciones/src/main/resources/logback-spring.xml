<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs con serviceName (OWASP A09 - LOG-03).
  Nota: ms-notificaciones es reactivo (WebFlux); el correlationId viaja por el Reactor Context
  (ver CorrelationIdWebFilter), no por MDC, por lo que no se referencia %X{correlationId} aqui.
  Los puntos de log de request/respuesta (GlobalExceptionHandler) incluyen el corr=... en el
  mensaje explicitamente en su lugar.
  Nunca se registra una contrasena, un token/JWT, un OTP ni el verify-token de WhatsApp.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="ms-notificaciones"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} %-5level [${serviceName}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
